<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asp_App</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/Asp_App.styles.css" asp-append-version="true" />
    <link href="~/css/output.css" rel="stylesheet" />
</head>
<body>
    <header class="w-full h-18 flex items-center justify-center">
        
        <nav class="w-full h-full bg-stone-100 flex items-center justify-center p-5 shadow-[0px_2px_4px_#f0f0f0]">
            <a href=""><h1 class="text-black text-2xl font-light absolute left-5 top-5">Asp App</h1></a>
            
            <ul class="w-fit h-full flex items-center justify-center gap-5 text-black">
                <li><a href="" class="">Home</a></li>
                <li><a href="" class="">Cadastrar</a></li>
                <li><a href="" class="">Perfil</a></li>
                <li><a href="" class="">Editar</a></li>
            </ul>
        </nav>
    </header>
    <div class="w-full min-h-screen">
        <main role="main" class="w-full h-[50vh] flex items-center justify-center">
            @RenderBody()
        </main>
    </div>

    <footer class="w-full h-16 bg-yellow-600 shadow-[0px_-2px_4px_#f0f0f0] flex items-center justify-center fixed z-5 bottom-0">
        <div class="container text-black text-xl">
            &copy; 2026 - Asp_App - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
